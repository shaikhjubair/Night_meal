# ==============================================================================
# NIGHTSHIFT EXPRESS - SUPABASE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and replace with your project values from:
# Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Key (Keep server-side only in Edge Functions / Webhooks)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
